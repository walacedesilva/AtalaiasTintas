# Dockerfile for Celery Worker
FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    C_FORCE_ROOT=1

# Set work directory
WORKDIR /app

# Install system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
        gettext \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd --create-home --shell /bin/bash worker \
    && chown -R worker:worker /app
USER worker

# Install Python dependencies
# Layer 1: heavy scientific packages — rarely change
COPY --chown=worker:worker requirements/heavy.txt /app/requirements/heavy.txt
RUN --mount=type=cache,target=/home/worker/.cache/pip,uid=1000,gid=1000 \
    pip install --user -r requirements/heavy.txt

# Layer 2: remaining dependencies
COPY --chown=worker:worker requirements/ /app/requirements/
RUN --mount=type=cache,target=/home/worker/.cache/pip,uid=1000,gid=1000 \
    pip install --user -r requirements/base.txt

# Copy application code
COPY --chown=worker:worker . /app/

# Create necessary directories
RUN mkdir -p /app/logs

# Make sure Python packages are in PATH
ENV PATH="/home/worker/.local/bin:${PATH}"

# Health check for worker (check if Celery is responsive)
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD bash -c "cd /app/backend && celery -A tintas_system inspect ping" || exit 1

# Default command for Celery worker
CMD ["sh", "-c", "cd backend && celery -A tintas_system worker --loglevel=info --concurrency=2"]