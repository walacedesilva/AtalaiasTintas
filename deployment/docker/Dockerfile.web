# Dockerfile for Django Web Application
FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Set work directory
WORKDIR /app

# Install system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
        gettext \
        git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd --create-home --shell /bin/bash app \
    && chown -R app:app /app
USER app

# Install Python dependencies
COPY --chown=app:app requirements/ /app/requirements/
RUN pip install --user -r requirements/base.txt

# Copy application code
COPY --chown=app:app . /app/

# Create necessary directories
RUN mkdir -p /app/logs /app/static /app/media

# Make sure Python packages are in PATH
ENV PATH="/home/app/.local/bin:${PATH}"

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

# Default command (can be overridden in docker-compose.yml)
CMD ["sh", "-c", "cd backend && python manage.py runserver 0.0.0.0:8000"]