# ============================================================
# ATALAIA TINTAS — Environment Variables Template
# Copy to .env and fill in your values before running.
# ============================================================

# ── Django Core ─────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://atalaia:password@localhost:5432/atalaia_tintas
# Fallback SQLite (development only):
# DATABASE_URL=sqlite:///db.sqlite3

# ── Redis / Celery ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Email ───────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.mailserver.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@atalaia.com.br
EMAIL_HOST_PASSWORD=email-password-here

# ── Sentry (optional) ───────────────────────────────────────
SENTRY_DSN=

# ── Storage (S3 for NFe XMLs / PDFs) ────────────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=atalaia-tintas-nfe
AWS_S3_REGION_NAME=sa-east-1
AWS_S3_CUSTOM_DOMAIN=

# ============================================================
# NF-e / SEFAZ Integration
# ============================================================

# SEFAZ Environment: HOMOLOGACAO | PRODUCAO
NFE_AMBIENTE=HOMOLOGACAO

# SEFAZ webservice timeout (seconds)
NFE_TIMEOUT=30

# NF-e series number (typically 1)
NFE_SERIE=1

# Certificate (A1 — .pfx / .p12 file)
NFE_CERTIFICADO_PATH=/path/to/certificado.pfx
NFE_CERTIFICADO_SENHA=senha-do-certificado

# UF emitente (state code, e.g. SP=35, RJ=33, BA=29)
NFE_UF_IBGE=35

# CNPJ emitente (digits only, no punctuation)
NFE_CNPJ_EMITENTE=12345678000195

# Fiscal regime: 1=Simples Nacional, 2=Simples Nacional Excesso, 3=Regime Normal
NFE_REGIME_TRIBUTARIO=1

# CST / CSOSN defaults for outbound NF-e items
NFE_CST_ICMS_PADRAO=400
NFE_CSOSN_PADRAO=400
NFE_CFOP_SAIDA_ESTADUAL=5102
NFE_CFOP_SAIDA_INTERESTADUAL=6102

# ICMS / PIS / COFINS default rates (percentage)
NFE_ALIQUOTA_PIS=0.65
NFE_ALIQUOTA_COFINS=3.00

# Auto-emit NF-e for B2B sales (CNPJ customers)
NFE_AUTO_EMISSAO_B2B=True

# Maximum automatic retry attempts before flagging for manual retry
NFE_MAX_TENTATIVAS_AUTO=3

# Retry interval in minutes between automatic attempts
NFE_RETRY_INTERVALO_MIN=5

# ── NFe URL overrides (leave blank to use defaults per UF/ambiente) ─
SEFAZ_URL_AUTORIZACAO=
SEFAZ_URL_RETORNO_AUTORIZACAO=
SEFAZ_URL_CONSULTA_PROTOCOLO=
SEFAZ_URL_CANCELAMENTO=
SEFAZ_URL_STATUS_SERVICO=
