# Environment Variables - AtalaiasTintas System

# Django Configuration
DJANGO_ENVIRONMENT=development
SECRET_KEY=django-insecure-change-me-in-production-2024-tintas-system
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Updated to match new structure)
DB_NAME=tintas_system_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=prefer

# Legacy database variables (for backwards compatibility)
DATABASE_NAME=tintas_db
DATABASE_USER=tintas_user
DATABASE_PASSWORD=SenhaSuperSegura123!
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/1

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_ALWAYS_EAGER=False

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Tintas System <noreply@tintas.com>

# Static and Media Files
STATIC_ROOT=/path/to/staticfiles
MEDIA_ROOT=/path/to/mediafiles

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/tintas_system/django.log

# Security Settings (Production)
SECURE_SSL_REDIRECT=False

# Monitoring & Alerts (New infrastructure features)
ALERT_EMAIL_LIST=admin@tintas.com
ALERT_SMS_LIST=+5511999999999

# AWS Configuration (for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
BACKUP_BUCKET_NAME=

# Marketplace APIs
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_ACCESS_TOKEN=

# Fiscal Configuration
SEFAZ_AMBIENTE=HOMOLOGACAO
CERTIFICADO_DIGITAL_PATH=
CERTIFICADO_DIGITAL_SENHA=

# Error Monitoring (Enhanced)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Testing Configuration
USE_SQLITE_TESTS=False
DISABLE_MIGRATIONS_IN_TESTS=True
FAST_TESTS=True
TEST_DB_NAME=test_tintas_system
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# Development Options
DEBUG_TOOLBAR=True
SHOW_SQL_QUERIES=False
DISABLE_MIGRATIONS=False